{
	"name": "@carl/monorepo",
	"private": true,
	"scripts": {
		"dev": "pnpm --parallel -r dev",
		"check": "prettier --check . && pnpm --recursive --parallel check",
		"fix": "prettier --write . && pnpm --recursive --parallel fix"
	},
	"devDependencies": {
		"prettier": "^3.9.10"
	},
	"packageManager": "pnpm@12.16.0",
	"volta": {
		"node": "26.12.1",
		"pnpm": "12.16.0"
	}
}
